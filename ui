local function C3(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function preset(p)
	local t = {}
	for k, v in pairs(p) do t[k] = C3(v) end
	t.accentDim = t.accentDim or t.accent:Lerp(t.bg, 0.6)
	t.toggle_on = t.toggle_on or t.accent
	return t
end

