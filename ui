local function inRect(mx, my, x, y, w, h)
	return mx >= x and mx <= x + w and my >= y and my <= y + h
end

local function clamp(v, a, b)
	return math.max(a, math.min(b, v))
end

local function round(v)
	return math.floor(v + 0.5)
end

local function lum(c)
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

local function fire(cb, ...)
	if type(cb) ~= "function" then
		return
	end
	local ok, err = pcall(cb, ...)
	if not ok then
		warn("[Library] callback error: " .. tostring(err))
	end
end

local function setColor(obj, color)
	obj.Color = color
end

local function keyName(k)
	if k == nil then
		return "None"
	end
	if k.EnumType == Enum.UserInputType then
		if k == Enum.UserInputType.MouseButton1 then return "MB1" end
		if k == Enum.UserInputType.MouseButton2 then return "MB2" end
		if k == Enum.UserInputType.MouseButton3 then return "MB3" end
		return k.Name
	end
	local n = k.Name
	n = n:gsub("^Left(%u)", "L%1")
	n = n:gsub("^Right(%u)", "R%1")
	n = n:gsub("Control", "Ctrl")
	return n
end

local function matchKey(input, key)
	if key.EnumType == Enum.KeyCode then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key
	end
	return input.UserInputType == key
end

-- physical state of a bound key / mouse button (independent of what the game did with the event)
local function isDown(key)
	if key == nil then
		return false
	end
	if key.EnumType == Enum.KeyCode then
		return UIS:IsKeyDown(key)
	end
	local ok, r = pcall(function() return UIS:IsMouseButtonPressed(key) end)
	return ok and r == true
end

local function encodeKey(k)
	if k == nil then
		return { t = "None" }
	end
	return { t = (k.EnumType == Enum.KeyCode) and "KeyCode" or "UserInputType", n = k.Name }
end

-- returns key, valid
local function decodeKey(v)
	if type(v) ~= "table" or v.t == nil or v.t == "None" then
		return nil, type(v) == "table"
	end
	local ok, item = pcall(function() return Enum[v.t][v.n] end)
	if ok and item then
		return item, true
	end
	return nil, false
end

local DIGITS = { Zero = 0, One = 1, Two = 2, Three = 3, Four = 4, Five = 5, Six = 6, Seven = 7, Eight = 8, Nine = 9 }
local SHIFT_DIGITS = { [0] = ")", "!", "@", "#", "$", "%", "^", "&", "*", "(" }
local PUNCT = {
	Space = { " ", " " }, Minus = { "-", "_" }, Equals = { "=", "+" }, Period = { ".", ">" },
	Comma = { ",", "<" }, Slash = { "/", "?" }, Semicolon = { ";", ":" }, Quote = { "'", '"' },
	LeftBracket = { "[", "{" }, RightBracket = { "]", "}" }, BackSlash = { "\\", "|" },
	Backquote = { "`", "~" }, KeypadPeriod = { ".", "." }, KeypadMinus = { "-", "-" },
}

local function keyToChar(kc)
	local shift = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
	local n = kc.Name
	if #n == 1 and n:match("%a") then
		return shift and n:upper() or n:lower()
	end
	local digitName = n:gsub("^Keypad", "")
	local d = DIGITS[n] or DIGITS[digitName]
	if d ~= nil then
		if shift and DIGITS[n] ~= nil then
			return SHIFT_DIGITS[d]
		end
		return tostring(d)
	end
	local p = PUNCT[n]
	if p then
		return shift and p[2] or p[1]
	end
	return nil
end

-- places n adjacent bands across [0, total) in whole pixels: returns x0, width for band i
local function band(i, n, total)
	local a = math.floor((i - 1) * total / n)
	local b = math.floor(i * total / n)
	return a, math.max(0, b - a)
end

----------------------------------------------------------------------
-- text measuring (shared by windows and notifications)
-- widths are cached so a string always measures the same.
-- TextBounds can be stale right after Text is changed (that is what made
-- dropdown values collapse to "..."), so every read is sanity checked and
-- implausible values are replaced by an estimate that is never cached.
----------------------------------------------------------------------

local measurer
local widthCache, cacheCount = {}, 0

local function releaseMeasurer()
	if measurer then
		pcall(function() measurer:Remove() end)
		measurer = nil
	end
	widthCache, cacheCount = {}, 0
end

local function textW(str, size)
	str = tostring(str)
	if str == "" then
		return 0
	end
	local key = size .. ":" .. str
	local hit = widthCache[key]
	if hit then
		return hit
	end
	if not measurer then
		measurer = Drawing.new("Text")
		measurer.Font = FONT
		measurer.Visible = true
		measurer.Transparency = 0
	end
	measurer.Size = size
	measurer.Text = "" -- forces the bounds to be recomputed for the new string
	measurer.Text = str
	local ok, b = pcall(function() return measurer.TextBounds end)
	local w = (ok and b) and b.X or 0
	local est = #str * size * 0.55
	if w <= 0 or w < #str * size * 0.2 or w > #str * size * 1.1 then
		return est -- unreliable read: estimate, not cached
	end
	if cacheCount > 3000 then
		widthCache, cacheCount = {}, 0
	end
	widthCache[key] = w
	cacheCount = cacheCount + 1
	return w
end

local function fitText(str, size, maxW)
	str = tostring(str)
	if textW(str, size) <= maxW then
		return str
	end
	local s = str
	while #s > 1 and textW(s .. "...", size) > maxW do
		s = s:sub(1, -2)
	end
	return s .. "..."
end

local function fitTail(str, size, maxW)
	local s = tostring(str)
	while #s > 1 and textW(s, size) > maxW do
		s = s:sub(2)
	end
	return s
end

local function wrapText(text, size, maxW)
	local lines = {}
	for para in (tostring(text) .. "\n"):gmatch("(.-)\n") do
		local line = ""
		for word in para:gmatch("%S+") do
			local try = (line == "") and word or (line .. " " .. word)
			if line == "" or textW(try, size) <= maxW then
				line = try
			else
				table.insert(lines, line)
				line = word
			end
			while textW(line, size) > maxW and #line > 1 do
				local cut = #line
				while cut > 1 and textW(line:sub(1, cut), size) > maxW do
					cut = cut - 1
				end
				table.insert(lines, line:sub(1, cut))
				line = line:sub(cut + 1)
			end
		end
		table.insert(lines, line)
	end
	return lines
end

----------------------------------------------------------------------
-- file storage (configs)
----------------------------------------------------------------------

local FS = {}

function FS.supported()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
		and type(isfolder) == "function" and type(makefolder) == "function"
		and type(listfiles) == "function" and type(delfile) == "function"
end

local function ensureFolder(path)
	local acc = ""
	for part in path:gmatch("[^/]+") do
		acc = (acc == "") and part or (acc .. "/" .. part)
		if not isfolder(acc) then
			makefolder(acc)
		end
	end
end

local function cleanName(n)
	n = tostring(n or "")
	n = n:gsub("^%s+", "")
	n = n:gsub("%s+$", "")
	if n == "" then return nil, "Enter a name first" end
	if #n > 32 then return nil, "Name is too long (max 32 characters)" end
	if not n:match("^[%w _%-]+$") then return nil, "Use only letters, numbers, spaces, - and _" end
	return n
end

local NO_FS = "File functions are not supported by this executor"

local Store = {}
Store.__index = Store

function Store.new(root, sub)
	local self = setmetatable({}, Store)
	self.root = root
	self.dir = root .. "/" .. sub
	self.autoPath = root .. "/" .. sub .. "_autoload.txt"
	if FS.supported() then
		pcall(ensureFolder, self.dir)
	end
	return self
end

function Store:_path(name)
	return self.dir .. "/" .. name .. ".json"
end

function Store:List()
	local out = {}
	if not FS.supported() then return out end
	local ok, files = pcall(listfiles, self.dir)
	if not ok or type(files) ~= "table" then return out end
	for _, f in ipairs(files) do
		local name = tostring(f):match("([^/\\]+)%.json$")
		if name then table.insert(out, name) end
	end
	table.sort(out, function(a, b) return a:lower() < b:lower() end)
	return out
end

function Store:Exists(name)
	if not FS.supported() then return false end
	local ok, r = pcall(isfile, self:_path(name))
	return ok and r == true
end

function Store:Write(name, data)
	if not FS.supported() then return false, NO_FS end
	local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
	if not ok then return false, "Could not encode data" end
	local ok2, err = pcall(function()
		ensureFolder(self.dir)
		writefile(self:_path(name), enc)
	end)
	if not ok2 then return false, tostring(err) end
	return true
end

function Store:Read(name)
	if not FS.supported() then return nil, NO_FS end
	if not self:Exists(name) then return nil, "'" .. name .. "' does not exist" end
	local ok, raw = pcall(readfile, self:_path(name))
	if not ok then return nil, "Could not read the file" end
	local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return nil, "The file is corrupted" end
	return data
end

function Store:Delete(name)
	if not FS.supported() then return false, NO_FS end
	local ok, err = pcall(delfile, self:_path(name))
	if not ok then return false, tostring(err) end
	return true
end

function Store:RawAutoload()
	if not FS.supported() then return nil end
	local ok, exists = pcall(isfile, self.autoPath)
	if not ok or not exists then return nil end
	local ok2, raw = pcall(readfile, self.autoPath)
	if not ok2 then return nil end
	raw = tostring(raw):gsub("%s+", " ")
	raw = raw:gsub("^%s+", "")
	raw = raw:gsub("%s+$", "")
	if raw == "" then return nil end
	return raw
end

function Store:GetAutoload()
	local name = self:RawAutoload()
	if name and self:Exists(name) then return name end
	return nil
end

function Store:SetAutoload(name)
	if not FS.supported() then return false, NO_FS end
	local ok, err = pcall(function()
		ensureFolder(self.root)
		writefile(self.autoPath, name)
	end)
	if not ok then return false, tostring(err) end
	return true
end

function Store:ClearAutoload()
	if not FS.supported() then return false, NO_FS end
	pcall(function()
		if isfile(self.autoPath) then delfile(self.autoPath) end
	end)
	return true
end

local function readJSON(path)
	if not FS.supported() then return nil end
	local ok, exists = pcall(isfile, path)
	if not ok or not exists then return nil end
	local ok2, raw = pcall(readfile, path)
	if not ok2 then return nil end
	local ok3, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if ok3 and type(data) == "table" then return data end
	return nil
end

local function writeJSON(root, path, data)
	if not FS.supported() then return false end
	return pcall(function()
		ensureFolder(root)
		writefile(path, HttpService:JSONEncode(data))
	end)
end

local function readText(path)
	if not FS.supported() then return nil end
	local ok, exists = pcall(isfile, path)
	if not ok or not exists then return nil end
	local ok2, raw = pcall(readfile, path)
	if not ok2 then return nil end
	raw = tostring(raw):gsub("^%s+", "")
	raw = raw:gsub("%s+$", "")
	if raw == "" then return nil end
	return raw
end

local function writeText(root, path, text)
	if not FS.supported() then return false end
	return pcall(function()
		ensureFolder(root)
		writefile(path, tostring(text))
	end)
end

----------------------------------------------------------------------
-- image loading (window logo)
-- Drawing images take raw image bytes, so rbxassetid / urls are downloaded
-- first. Local files (readfile) work too.
----------------------------------------------------------------------

local imageCache = {}

local function httpGet(url)
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and type(res) == "string" and #res > 0 then return res end
	local req = (syn and syn.request) or request or http_request or (http and http.request)
	if req then
		local ok2, r = pcall(req, { Url = url, Method = "GET" })
		if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0 then
			return r.Body
		end
	end
	return nil
end

local function loadImageBytes(src)
	src = tostring(src)
	if imageCache[src] then return imageCache[src] end
	local bytes
	local id = src:match("^rbxassetid://(%d+)") or src:match("[?&]id=(%d+)") or src:match("^(%d+)$")
	if id and not src:match("^https?://[^?]*%.%a+$") then
		bytes = httpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. id)
		-- decal ids return a small xml pointing at the real image id
		if bytes and bytes:find("<roblox", 1, true) then
			local inner = bytes:match("<url>[^<]-id=(%d+)</url>")
			bytes = inner and httpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. inner) or nil
		end
	elseif src:match("^https?://") then
		bytes = httpGet(src)
	elseif FS.supported() then
		local ok, exists = pcall(isfile, src)
		if ok and exists then
			local ok2, raw = pcall(readfile, src)
			if ok2 then bytes = raw end
		end
	end
	if bytes and #bytes > 0 then
		imageCache[src] = bytes
		return bytes
	end
	return nil
end

